@page

@{
    ViewData["Title"] = "Kullanıcı Girişi";
}


<div class="content-header mb-4">

    <h1>👤 Kullanıcı İşlemleri</h1>

    <p class="text-muted">
        Sisteme giriş yapabilir veya yeni kullanıcı kaydı oluşturabilirsiniz.
    </p>

</div>


<div class="row">


    <!-- ====================================================== -->
    <!-- GİRİŞ YAP -->
    <!-- ====================================================== -->

    <div class="col-md-6">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    🔐 Giriş Yap
                </h3>

            </div>


            <div class="card-body">


                <!-- E-POSTA -->

                <div class="mb-3">

                    <label for="girisEposta"
                           class="form-label">

                        E-posta

                    </label>


                    <input type="email"
                           id="girisEposta"
                           class="form-control"
                           autocomplete="email"
                           placeholder="E-posta adresinizi giriniz" />

                </div>


                <!-- ŞİFRE -->

                <div class="mb-3">

                    <label for="girisSifre"
                           class="form-label">

                        Şifre

                    </label>


                    <input type="password"
                           id="girisSifre"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Şifrenizi giriniz" />

                </div>


                <!-- BUTON -->

                <button type="button"
                        id="girisBtn"
                        class="btn btn-success"
                        onclick="girisYap()">

                    <i class="fas fa-right-to-bracket"></i>
                    Giriş Yap

                </button>


                <!-- MESAJ -->

                <div id="girisMesaj"
                     class="mt-3 d-none">
                </div>


                <!-- GEÇİCİ OTURUM BİLGİSİ -->

                <div class="alert alert-warning mt-4 mb-0">

                    <strong>Bilgi:</strong>

                    Backend henüz JWT, cookie veya gerçek oturum bilgisi
                    üretmediği için kullanıcı oturumu şu anda geçici
                    olarak doğrulanmaktadır.

                    Şifre tarayıcıda saklanmaz.

                </div>


            </div>

        </div>

    </div>



    <!-- ====================================================== -->
    <!-- KAYIT OL -->
    <!-- ====================================================== -->

    <div class="col-md-6">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    📝 Kayıt Ol
                </h3>

            </div>


            <div class="card-body">


                <!-- İSİM -->

                <div class="mb-3">

                    <label for="isim"
                           class="form-label">

                        İsim

                    </label>


                    <input type="text"
                           id="isim"
                           class="form-control"
                           autocomplete="given-name"
                           placeholder="İsminizi giriniz" />

                </div>


                <!-- SOYİSİM -->

                <div class="mb-3">

                    <label for="soyisim"
                           class="form-label">

                        Soyisim

                    </label>


                    <input type="text"
                           id="soyisim"
                           class="form-control"
                           autocomplete="family-name"
                           placeholder="Soyisminizi giriniz" />

                </div>


                <!-- E-POSTA -->

                <div class="mb-3">

                    <label for="kayitEposta"
                           class="form-label">

                        E-posta

                    </label>


                    <input type="email"
                           id="kayitEposta"
                           class="form-control"
                           autocomplete="email"
                           placeholder="E-posta adresinizi giriniz" />

                </div>


                <!-- ŞİFRE -->

                <div class="mb-3">

                    <label for="kayitSifre"
                           class="form-label">

                        Şifre

                    </label>


                    <input type="password"
                           id="kayitSifre"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Şifre oluşturunuz" />

                </div>


                <!-- ŞİFRE TEKRAR -->

                <div class="mb-3">

                    <label for="sifreTekrar"
                           class="form-label">

                        Şifre Tekrar

                    </label>


                    <input type="password"
                           id="sifreTekrar"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Şifrenizi tekrar giriniz" />

                </div>


                <!-- BUTON -->

                <button type="button"
                        id="kayitBtn"
                        class="btn btn-primary"
                        onclick="kayitOl()">

                    <i class="fas fa-user-plus"></i>
                    Kayıt Ol

                </button>


                <!-- MESAJ -->

                <div id="kayitMesaj"
                     class="mt-3 d-none">
                </div>


            </div>

        </div>

    </div>


</div>



@section Scripts {

    <script>

        // =====================================================
        // MESAJ GÖSTER
        // =====================================================

        function mesajGoster(
            alanId,
            mesaj,
            tur
        ) {

            const alan =
                document.getElementById(
                    alanId
                );


            alan.className =
                "alert alert-" +
                tur +
                " mt-3";


            alan.innerText =
                mesaj;

        }



        // =====================================================
        // E-POSTA KONTROLÜ
        // =====================================================

        function epostaGecerliMi(eposta) {

            return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/
                .test(eposta);

        }



        // =====================================================
        // GİRİŞ YAP
        // =====================================================

        async function girisYap() {

            const eposta =
                document.getElementById(
                    "girisEposta"
                ).value.trim();


            const sifre =
                document.getElementById(
                    "girisSifre"
                ).value;


            const buton =
                document.getElementById(
                    "girisBtn"
                );


            // -----------------------------------------
            // BOŞ ALAN KONTROLÜ
            // -----------------------------------------

            if (
                eposta === "" ||
                sifre === ""
            ) {

                mesajGoster(
                    "girisMesaj",
                    "E-posta ve şifre alanlarını doldurun.",
                    "warning"
                );

                return;

            }


            // -----------------------------------------
            // E-POSTA KONTROLÜ
            // -----------------------------------------

            if (!epostaGecerliMi(eposta)) {

                mesajGoster(
                    "girisMesaj",
                    "Geçerli bir e-posta adresi giriniz.",
                    "warning"
                );

                return;

            }



            // -----------------------------------------
            // BACKEND GİRİŞ MODELİ
            // -----------------------------------------

            const girisBilgileri = {

                eposta: eposta,

                sifre: sifre

            };


            try {

                // BUTONU KİLİTLE

                buton.disabled =
                    true;


                buton.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Giriş yapılıyor...';



                // -----------------------------------------
                // API
                // POST /api/Kullanici/giris-yap
                // -----------------------------------------

                const sonuc =
                    await apiPost(
                        "/api/Kullanici/giris-yap",
                        girisBilgileri
                    );



                // -----------------------------------------
                // BACKEND MESAJINI GÖSTER
                // -----------------------------------------

                let mesaj =
                    sonuc?.message ??
                    "Giriş başarılı.";


                if (sonuc?.isim) {

                    mesaj +=
                        " Hoş geldiniz, " +
                        sonuc.isim +
                        ".";

                }


                mesajGoster(
                    "girisMesaj",
                    mesaj,
                    "success"
                );



                // -----------------------------------------
                // ŞİFREYİ TEMİZLE
                // -----------------------------------------

                document.getElementById(
                    "girisSifre"
                ).value =
                    "";



                /*
                    ==================================================
                    GEÇİCİ OTURUM YÖNETİMİ
                    ==================================================

                    Backend şu anda:

                    - JWT döndürmüyor
                    - Cookie oluşturmuyor
                    - Session bilgisi döndürmüyor

                    Bu nedenle burada gerçek kullanıcı oturumu
                    oluşturulmuyor.

                    Özellikle şifre:

                    localStorage'a KAYDEDİLMEZ
                    sessionStorage'a KAYDEDİLMEZ

                    Backend authentication tamamlandığında
                    bu bölüm yeniden düzenlenecektir.
                */


                console.log(
                    "Giriş başarılı:",
                    sonuc
                );

            }

            catch (error) {

                console.error(
                    "Giriş API hatası:",
                    error
                );


                mesajGoster(
                    "girisMesaj",
                    error.message ||
                    "Giriş işlemi gerçekleştirilemedi.",
                    "danger"
                );

            }

            finally {

                buton.disabled =
                    false;


                buton.innerHTML =
                    '<i class="fas fa-right-to-bracket"></i> Giriş Yap';

            }

        }



        // =====================================================
        // KAYIT OL
        // =====================================================

        async function kayitOl() {

            const isim =
                document.getElementById(
                    "isim"
                ).value.trim();


            const soyisim =
                document.getElementById(
                    "soyisim"
                ).value.trim();


            const eposta =
                document.getElementById(
                    "kayitEposta"
                ).value.trim();


            const sifre =
                document.getElementById(
                    "kayitSifre"
                ).value;


            const sifreTekrar =
                document.getElementById(
                    "sifreTekrar"
                ).value;


            const buton =
                document.getElementById(
                    "kayitBtn"
                );



            // -----------------------------------------
            // BOŞ ALAN KONTROLÜ
            // -----------------------------------------

            if (
                isim === "" ||
                soyisim === "" ||
                eposta === "" ||
                sifre === "" ||
                sifreTekrar === ""
            ) {

                mesajGoster(
                    "kayitMesaj",
                    "Lütfen bütün alanları doldurun.",
                    "warning"
                );

                return;

            }



            // -----------------------------------------
            // E-POSTA KONTROLÜ
            // -----------------------------------------

            if (!epostaGecerliMi(eposta)) {

                mesajGoster(
                    "kayitMesaj",
                    "Geçerli bir e-posta adresi giriniz.",
                    "warning"
                );

                return;

            }



            // -----------------------------------------
            // ŞİFRE KONTROLÜ
            // -----------------------------------------

            if (sifre !== sifreTekrar) {

                mesajGoster(
                    "kayitMesaj",
                    "Şifreler birbiriyle aynı değil.",
                    "warning"
                );

                return;

            }



            // -----------------------------------------
            // BACKEND KULLANICILAR MODELİ
            // -----------------------------------------

            const yeniKullanici = {

                isim: isim,

                soyisim: soyisim,

                eposta: eposta,

                sifre: sifre

            };


            try {

                // BUTONU KİLİTLE

                buton.disabled =
                    true;


                buton.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';



                // -----------------------------------------
                // API
                // POST /api/Kullanici/kayit-ol
                // -----------------------------------------

                const sonuc =
                    await apiPost(
                        "/api/Kullanici/kayit-ol",
                        yeniKullanici
                    );



                // -----------------------------------------
                // BACKEND MESAJINI GÖSTER
                // -----------------------------------------

                mesajGoster(
                    "kayitMesaj",
                    sonuc?.message ??
                    "Kayıt işlemi başarıyla gerçekleşti.",
                    "success"
                );



                // -----------------------------------------
                // FORMU TEMİZLE
                // -----------------------------------------

                document.getElementById(
                    "isim"
                ).value =
                    "";


                document.getElementById(
                    "soyisim"
                ).value =
                    "";


                document.getElementById(
                    "kayitEposta"
                ).value =
                    "";


                document.getElementById(
                    "kayitSifre"
                ).value =
                    "";


                document.getElementById(
                    "sifreTekrar"
                ).value =
                    "";

            }

            catch (error) {

                console.error(
                    "Kayıt API hatası:",
                    error
                );


                mesajGoster(
                    "kayitMesaj",
                    error.message ||
                    "Kayıt işlemi gerçekleştirilemedi.",
                    "danger"
                );

            }

            finally {

                buton.disabled =
                    false;


                buton.innerHTML =
                    '<i class="fas fa-user-plus"></i> Kayıt Ol';

            }

        }



        // =====================================================
        // ENTER İLE GİRİŞ
        // =====================================================

        document.getElementById(
            "girisSifre"
        ).addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    girisYap();

                }

            }
        );

    </script>

}