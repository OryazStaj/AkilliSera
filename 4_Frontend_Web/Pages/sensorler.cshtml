@page

@{
    ViewData["Title"] = "Sensörler";
}

<div class="content-header mb-4">

    <h1>🌡️ Sensör ve Sistem Durumları</h1>

    <p class="text-muted">
        Seradaki sensörlerin anlık değerlerini ve cihazların çalışma durumlarını takip edebilirsiniz.
    </p>

</div>


<!-- ESP32 DURUMU -->
<div class="card mb-4">

    <div class="card-header">
        <h3 class="card-title">
            📡 ESP32 Bağlantı Durumu
        </h3>
    </div>

    <div class="card-body">

        <p>
            <strong>Durum:</strong>

            <span id="cihazDurumu"
                  class="badge bg-secondary">
                Kontrol ediliyor...
            </span>
        </p>

        <p class="mb-0">
            <strong>Son Görülme:</strong>

            <span id="sonGorulme">
                --
            </span>
        </p>

        <div id="cihazHata"
             class="alert alert-danger mt-3 d-none">
        </div>

    </div>

</div>


<!-- GENEL DURUM -->
<div id="genelSistemDurumu"
     class="alert alert-info">

    Sensör verileri yükleniyor...

</div>

<div id="arizaBildirimleri"></div>


<!-- SENSÖRLER -->
<h4 class="mb-3">
    Sensörler
</h4>

<div class="row">

    <!-- SICAKLIK -->
    <div class="col-lg-4 col-md-6 col-12">

        <div class="small-box text-bg-secondary"
             id="sicaklikKarti">

            <div class="inner">

                <h3 id="sicaklikDegeri">
                    --
                </h3>

                <p>Sıcaklık</p>

                <span id="sicaklikDurumu"
                      class="badge bg-light text-dark">
                    Veri bekleniyor
                </span>

            </div>

            <div class="small-box-icon">
                🌡️
            </div>

        </div>

    </div>


    <!-- ORTAM NEM -->
    <div class="col-lg-4 col-md-6 col-12">

        <div class="small-box text-bg-secondary"
             id="ortamNemKarti">

            <div class="inner">

                <h3 id="ortamNemDegeri">
                    --
                </h3>

                <p>Ortam Nemi</p>

                <span id="ortamNemDurumu"
                      class="badge bg-light text-dark">
                    Veri bekleniyor
                </span>

            </div>

            <div class="small-box-icon">
                💧
            </div>

        </div>

    </div>


    <!-- TOPRAK NEM -->
    <div class="col-lg-4 col-md-6 col-12">

        <div class="small-box text-bg-secondary"
             id="toprakNemKarti">

            <div class="inner">

                <h3 id="toprakNemDegeri">
                    --
                </h3>

                <p>Toprak Nemi</p>

                <span id="toprakNemDurumu"
                      class="badge bg-light text-dark">
                    Veri bekleniyor
                </span>

            </div>

            <div class="small-box-icon">
                🌱
            </div>

        </div>

    </div>

</div>


<!-- CİHAZ DURUMLARI -->
<h4 class="mt-4 mb-3">
    Cihaz Durumları
</h4>

<div class="row">

    <!-- SULAMA -->
    <div class="col-lg-4 col-md-6 col-12">

        <div class="small-box text-bg-secondary"
             id="sulamaKarti">

            <div class="inner">

                <h3 id="sulamaDurumu">
                    --
                </h3>

                <p>Sulama Sistemi</p>

                <span id="sulamaBilgi"
                      class="badge bg-light text-dark">
                    Durum verisi bekleniyor
                </span>

            </div>

            <div class="small-box-icon">
                💦
            </div>

        </div>

    </div>


    <!-- FAN -->
    <div class="col-lg-4 col-md-6 col-12">

        <div class="small-box text-bg-secondary"
             id="fanKarti">

            <div class="inner">

                <h3 id="fanDurumu">
                    --
                </h3>

                <p>Fan Sistemi</p>

                <span id="fanBilgi"
                      class="badge bg-light text-dark">
                    Durum verisi bekleniyor
                </span>

            </div>

            <div class="small-box-icon">
                🌀
            </div>

        </div>

    </div>


    <!-- ISITICI -->
    <div class="col-lg-4 col-md-6 col-12">

        <div class="small-box text-bg-secondary"
             id="isiticiKarti">

            <div class="inner">

                <h3 id="isiticiDurumu">
                    --
                </h3>

                <p>Isıtıcı Sistemi</p>

                <span id="isiticiBilgi"
                      class="badge bg-light text-dark">
                    Durum verisi bekleniyor
                </span>

            </div>

            <div class="small-box-icon">
                🔥
            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function tarihGoster(tarih) {

            if (!tarih)
                return "--";

            const t = new Date(tarih);

            if (isNaN(t.getTime()))
                return "--";

            return t.toLocaleString("tr-TR");
        }


        function arizaEkle(mesaj) {

            const alan =
                document.getElementById("arizaBildirimleri");

            const div =
                document.createElement("div");

            div.className =
                "alert alert-danger";

            div.innerText =
                mesaj;

            alan.appendChild(div);
        }


        function arizaTemizle() {

            document.getElementById(
                "arizaBildirimleri"
            ).innerHTML = "";
        }


        function sensorKartiGuncelle(
            kartId,
            degerId,
            durumId,
            deger,
            birim,
            sensorAdi
        ) {

            const kart =
                document.getElementById(kartId);

            const degerAlani =
                document.getElementById(degerId);

            const durumAlani =
                document.getElementById(durumId);


            if (
                deger !== null &&
                deger !== undefined
            ) {

                degerAlani.innerText =
                    Number(deger).toFixed(1) +
                    " " +
                    birim;

                durumAlani.innerText =
                    "Çalışıyor";

                kart.className =
                    "small-box text-bg-success";

            }
            else {

                degerAlani.innerText =
                    "--";

                durumAlani.innerText =
                    "Veri Alınamıyor";

                kart.className =
                    "small-box text-bg-danger";

                arizaEkle(
                    "⚠️ " +
                    sensorAdi +
                    " sensöründen veri alınamıyor."
                );
            }
        }


        function sensorleriGuncelle(
            sicaklik,
            ortamNem,
            toprakNem
        ) {

            arizaTemizle();

            sensorKartiGuncelle(
                "sicaklikKarti",
                "sicaklikDegeri",
                "sicaklikDurumu",
                sicaklik,
                "°C",
                "Sıcaklık"
            );

            sensorKartiGuncelle(
                "ortamNemKarti",
                "ortamNemDegeri",
                "ortamNemDurumu",
                ortamNem,
                "%",
                "Ortam nem"
            );

            sensorKartiGuncelle(
                "toprakNemKarti",
                "toprakNemDegeri",
                "toprakNemDurumu",
                toprakNem,
                "%",
                "Toprak nem"
            );
        }


        function cihazKartiGuncelle(
            kartId,
            durumId,
            bilgiId,
            cihazDurumu
        ) {

            const kart =
                document.getElementById(kartId);

            const durum =
                document.getElementById(durumId);

            const bilgi =
                document.getElementById(bilgiId);


            if (
                cihazDurumu === undefined ||
                cihazDurumu === null
            ) {

                durum.innerText =
                    "--";

                bilgi.innerText =
                    "Durum verisi bekleniyor";

                kart.className =
                    "small-box text-bg-secondary";

                return;
            }


            if (cihazDurumu === true) {

                durum.innerText =
                    "Çalışıyor";

                bilgi.innerText =
                    "Aktif";

                kart.className =
                    "small-box text-bg-success";
            }
            else {

                durum.innerText =
                    "Kapalı";

                bilgi.innerText =
                    "Pasif";

                kart.className =
                    "small-box text-bg-secondary";
            }
        }


        function cihazlariGuncelle(
            sulama,
            fan,
            isitici
        ) {

            cihazKartiGuncelle(
                "sulamaKarti",
                "sulamaDurumu",
                "sulamaBilgi",
                sulama
            );

            cihazKartiGuncelle(
                "fanKarti",
                "fanDurumu",
                "fanBilgi",
                fan
            );

            cihazKartiGuncelle(
                "isiticiKarti",
                "isiticiDurumu",
                "isiticiBilgi",
                isitici
            );
        }


        async function sensorVerileriniGetir() {

            const genelDurum =
                document.getElementById(
                    "genelSistemDurumu"
                );

            try {

                const veriler =
                    await apiGet(
                        "/api/Sensors/history?limit=50"
                    );


                if (
                    !Array.isArray(veriler) ||
                    veriler.length === 0
                ) {

                    genelDurum.className =
                        "alert alert-warning";

                    genelDurum.innerText =
                        "Henüz sensör verisi bulunmuyor.";

                    return;
                }


                const sirali =
                    [...veriler].sort(
                        (a, b) =>
                            new Date(a.kayitZamani)
                            -
                            new Date(b.kayitZamani)
                    );


                const veri =
                    sirali[sirali.length - 1];


                sensorleriGuncelle(
                    veri.ortamSicakligi,
                    veri.ortamNemi,
                    veri.toprakNemi
                );


                genelDurum.className =
                    "alert alert-success";

                genelDurum.innerText =
                    "Sensör verileri alınıyor. Son kayıt: " +
                    tarihGoster(
                        veri.kayitZamani
                    );

            }
            catch (error) {

                genelDurum.className =
                    "alert alert-danger";

                genelDurum.innerText =
                    "Sensör API bağlantısı kurulamadı.";

                arizaEkle(
                    "⚠️ Sensör sistemine bağlantı sağlanamadı."
                );

                console.error(error);
            }
        }


        async function cihazDurumunuGetir() {

            const durum =
                document.getElementById(
                    "cihazDurumu"
                );

            const sonGorulme =
                document.getElementById(
                    "sonGorulme"
                );

            const hata =
                document.getElementById(
                    "cihazHata"
                );

            hata.classList.add("d-none");


            try {

                const veri =
                    await apiGet(
                        "/api/Telemetry/health"
                    );


                if (veri.isOnline === true) {

                    durum.className =
                        "badge bg-success";

                    durum.innerText =
                        "Online";
                }
                else {

                    durum.className =
                        "badge bg-danger";

                    durum.innerText =
                        "Offline";
                }


                sonGorulme.innerText =
                    tarihGoster(
                        veri.lastSeen
                    );

            }
            catch (error) {

                durum.className =
                    "badge bg-danger";

                durum.innerText =
                    "Bağlantı Hatası";

                sonGorulme.innerText =
                    "--";

                hata.classList.remove(
                    "d-none"
                );

                hata.innerText =
                    "ESP32 durum bilgisi alınamadı.";
            }
        }


        const seraConnection =
            new signalR.HubConnectionBuilder()
                .withUrl(
                    `${API_BASE_URL}/serahub`
                )
                .withAutomaticReconnect()
                .build();


        seraConnection.on(
            "ReceiveTelemetry",
            function (veri) {

                console.log(
                    "Canlı telemetry:",
                    veri
                );


                sensorleriGuncelle(
                    veri.temperature,
                    veri.humidity,
                    veri.soilMoisture
                );


                cihazlariGuncelle(
                    veri.normalValve,
                    veri.fan,
                    veri.heater
                );


                const genelDurum =
                    document.getElementById(
                        "genelSistemDurumu"
                    );


                genelDurum.className =
                    "alert alert-success";


                genelDurum.innerText =
                    "Canlı sistem verisi alınıyor. Son veri: " +
                    tarihGoster(
                        veri.recordedAt
                    );
            }
        );


        async function signalRBaslat() {

            try {

                await seraConnection.start();

                console.log(
                    "SignalR bağlantısı kuruldu."
                );
            }
            catch (error) {

                console.error(
                    "SignalR bağlantı hatası:",
                    error
                );

                setTimeout(
                    signalRBaslat,
                    5000
                );
            }
        }


        seraConnection.onreconnected(
            function () {

                sensorVerileriniGetir();

            }
        );


        async function sayfayiBaslat() {

            await sensorVerileriniGetir();

            await cihazDurumunuGetir();

            await signalRBaslat();
        }


        sayfayiBaslat();


        setInterval(
            cihazDurumunuGetir,
            10000
        );

    </script>

}
