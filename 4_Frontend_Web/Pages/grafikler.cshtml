@page

@{
    ViewData["Title"] = "Grafikler";
}


<div class="content-header mb-4">

    <h1>📊 Sensör Grafikleri</h1>

    <p class="text-muted">
        Sıcaklık, ortam nemi ve toprak nemi verilerini geçmiş ve canlı olarak görüntüleyebilirsiniz.
    </p>

</div>


<!-- ====================================================== -->
<!-- BAĞLANTI DURUMU -->
<!-- ====================================================== -->

<div id="grafikBildirim"
     class="alert alert-info">

    <i class="fas fa-spinner fa-spin me-2"></i>
    Grafik verileri yükleniyor...

</div>


<!-- ====================================================== -->
<!-- GENEL BİLGİ KARTLARI -->
<!-- ====================================================== -->

<div class="row mb-4">

    <div class="col-lg-3 col-md-6 col-12">

        <div class="small-box text-bg-secondary">

            <div class="inner">

                <h3 id="toplamVeriSayisi">
                    0
                </h3>

                <p>
                    Gösterilen Kayıt
                </p>

            </div>

            <div class="small-box-icon">
                📋
            </div>

        </div>

    </div>


    <div class="col-lg-3 col-md-6 col-12">

        <div class="small-box text-bg-primary">

            <div class="inner">

                <h5 id="sonGuncelleme">
                    --
                </h5>

                <p>
                    Son Güncelleme
                </p>

            </div>

            <div class="small-box-icon">
                🕐
            </div>

        </div>

    </div>


    <div class="col-lg-3 col-md-6 col-12">

        <div class="small-box text-bg-danger">

            <div class="inner">

                <h3 id="genelMaxSicaklik">
                    --
                </h3>

                <p>
                    En Yüksek Sıcaklık
                </p>

            </div>

            <div class="small-box-icon">
                🔥
            </div>

        </div>

    </div>


    <div class="col-lg-3 col-md-6 col-12">

        <div class="small-box text-bg-success">

            <div class="inner">

                <h3 id="genelMinToprakNem">
                    --
                </h3>

                <p>
                    En Düşük Toprak Nemi
                </p>

            </div>

            <div class="small-box-icon">
                🌱
            </div>

        </div>

    </div>

</div>


<!-- ====================================================== -->
<!-- GRAFİK FİLTRESİ -->
<!-- ====================================================== -->

<div class="card mb-4">

    <div class="card-header">

        <h3 class="card-title">
            🔎 Grafik Görünümü
        </h3>

    </div>


    <div class="card-body">

        <div class="d-flex flex-wrap gap-2 align-items-center">

            <span class="me-2">
                Gösterilecek kayıt:
            </span>


            <button type="button"
                    class="btn btn-outline-primary grafik-filtre"
                    onclick="filtreUygula(10, this)">

                Son 10

            </button>


            <button type="button"
                    class="btn btn-outline-primary grafik-filtre"
                    onclick="filtreUygula(25, this)">

                Son 25

            </button>


            <button type="button"
                    class="btn btn-primary grafik-filtre"
                    onclick="filtreUygula(50, this)">

                Son 50

            </button>


            <button type="button"
                    class="btn btn-outline-secondary ms-md-auto"
                    onclick="sensorVerileriniGetir()">

                <i class="fas fa-rotate"></i>
                Yenile

            </button>

        </div>

    </div>

</div>


<!-- ====================================================== -->
<!-- GENEL SENSÖR GRAFİĞİ -->
<!-- ====================================================== -->

<div class="card mb-4">

    <div class="card-header">

        <h3 class="card-title">
            📈 Genel Sensör Grafiği
        </h3>

    </div>


    <div class="card-body">

        <p class="text-muted">
            Sıcaklık, ortam nemi ve toprak neminin zaman içerisindeki değişimini birlikte görüntüleyebilirsiniz.
