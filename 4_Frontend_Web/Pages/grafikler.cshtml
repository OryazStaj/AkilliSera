<div class="card mb-4">

    <div class="card-header">

        <h3 class="card-title">
            🌱 Toprak Nem Grafiği
        </h3>

    </div>


    <div class="card-body">

        <div class="row mb-4">

            <div class="col-lg-3 col-md-6">

                <div class="border rounded p-3">

                    <small class="text-muted">
                        Son Değer
                    </small>

                    <h4 id="toprakNemAnlik"
                        class="mb-0">

                        --

