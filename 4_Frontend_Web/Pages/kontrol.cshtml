@page

@{
    ViewData["Title"] = "Kontrol";
}

<div class="content-header mb-4">

    <h1>⚙️ Sera Kontrolü</h1>

    <p class="text-muted">
        Sera cihazlarının otomatik çalışma durumunu görüntüleyin
        ve manuel kontrol işlemlerini yönetin.
    </p>

</div>


<!-- ====================================================== -->
<!-- CİHAZ DURUMU -->
<!-- ====================================================== -->

<div class="card mb-4">

    <div class="card-header">

        <h3 class="card-title">
            📡 ESP32 Bağlantı Durumu
        </h3>

    </div>

    <div class="card-body">

        <p>

            Durum:

            <span id="cihazDurumu"
                  class="badge bg-secondary">

                Kontrol ediliyor...

            </span>

        </p>


        <p class="mb-0">

            <strong>Son Görülme:</strong>

            <span id="sonGorulme">
                --
            </span>

        </p>


        <div id="cihazHata"
             class="alert alert-danger mt-3 d-none">
        </div>

    </div>

</div>



<!-- ====================================================== -->
<!-- OTOMATİK KONTROL BİLGİSİ -->
<!-- ====================================================== -->

<div class="alert alert-info">

    <h5>
        🤖 Otomatik Kontrol Aktif
    </h5>

    <p class="mb-1">

        Sistem sensör verilerine göre cihazları
        backend üzerinden otomatik olarak yönetmektedir.

    </p>

    <small>

        Toprak nemi %30'un altına düştüğünde sulama,
        sıcaklık 32°C'nin üzerine çıktığında fan,
        sıcaklık 15°C'nin altına düştüğünde ısıtıcı
        otomatik olarak çalıştırılmaktadır.

    </small>

</div>



<div class="row">


    <!-- ================================================== -->
    <!-- FAN -->
    <!-- ================================================== -->

    <div class="col-lg-4 col-md-6 col-12">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    🌀 Fan Kontrolü
                </h3>

            </div>


            <div class="card-body">

                <p>

                    Manuel Kontrol:

                    <span class="badge bg-warning text-dark">
                        Backend Bekleniyor
                    </span>

                </p>


                <button type="button"
                        id="fanAcBtn"
                        class="btn btn-success me-2"
                        disabled>

                    <i class="fas fa-power-off"></i>
                    Fan Aç

                </button>


                <button type="button"
                        id="fanKapatBtn"
                        class="btn btn-danger"
                        disabled>

                    <i class="fas fa-stop"></i>
                    Fan Kapat

                </button>


                <div class="alert alert-warning mt-3 mb-0">

                    Fan için manuel kontrol API endpoint'i
                    henüz backend tarafından yayınlanmadı.

                </div>

            </div>

        </div>

    </div>



    <!-- ================================================== -->
    <!-- SULAMA -->
    <!-- ================================================== -->

    <div class="col-lg-4 col-md-6 col-12">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    💦 Sulama Kontrolü
                </h3>

            </div>


            <div class="card-body">

                <p>

                    Manuel Kontrol:

                    <span class="badge bg-warning text-dark">
                        Backend Bekleniyor
                    </span>

                </p>


                <button type="button"
                        id="sulamaAcBtn"
                        class="btn btn-success me-2"
                        disabled>

                    <i class="fas fa-faucet-drip"></i>
                    Sulama Aç

                </button>


                <button type="button"
                        id="sulamaKapatBtn"
                        class="btn btn-danger"
                        disabled>

                    <i class="fas fa-stop"></i>
                    Sulama Kapat

                </button>


                <div class="alert alert-warning mt-3 mb-0">

                    Sulama için manuel kontrol API endpoint'i
                    henüz backend tarafından yayınlanmadı.

                </div>

            </div>

        </div>

    </div>



    <!-- ================================================== -->
    <!-- İLAÇLAMA -->
    <!-- ================================================== -->

    <div class="col-lg-4 col-md-6 col-12">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    🧴 İlaçlama
                </h3>

            </div>


            <div class="card-body">

                <p>

                    İlaçlama kayıt ve geçmiş işlemleri
                    ayrı sayfadan yönetilmektedir.

                </p>


                <a asp-page="/Ilaclama"
                   class="btn btn-primary">

                    <i class="fas fa-spray-can"></i>

                    İlaçlama Sayfasına Git

                </a>

            </div>

        </div>

    </div>


</div>



@section Scripts {

    <script>

        // =========================================================
        // TARİH GÖSTERME
        // =========================================================

        function tarihGoster(tarih) {

            if (!tarih) {
                return "--";
            }


            const tarihNesnesi =
                new Date(tarih);


            if (
                isNaN(
                    tarihNesnesi.getTime()
                )
            ) {

                return "--";

            }


            return tarihNesnesi.toLocaleString(
                "tr-TR"
            );

        }



        // =========================================================
        // ESP32 DURUMUNU GETİR
        // =========================================================

        async function cihazDurumunuGetir() {

            const durum =
                document.getElementById(
                    "cihazDurumu"
                );


            const sonGorulme =
                document.getElementById(
                    "sonGorulme"
                );


            const hata =
                document.getElementById(
                    "cihazHata"
                );


            hata.classList.add(
                "d-none"
            );


            try {

                const veri =
                    await apiGet(
                        "/api/Telemetry/health"
                    );


                if (veri.isOnline) {

                    durum.className =
                        "badge bg-success";

                    durum.innerText =
                        "Online";

                }
                else {

                    durum.className =
                        "badge bg-danger";

                    durum.innerText =
                        "Offline";

                }


                sonGorulme.innerText =
                    tarihGoster(
                        veri.lastSeen
                    );

            }
            catch (error) {

                durum.className =
                    "badge bg-danger";

                durum.innerText =
                    "Bağlantı Hatası";


                sonGorulme.innerText =
                    "--";


                hata.classList.remove(
                    "d-none"
                );


                hata.innerText =
                    "ESP32 durum bilgisi alınamadı: " +
                    (
                        error.message ||
                        "API bağlantı hatası"
                    );


                console.error(
                    "Telemetry health hatası:",
                    error
                );

            }

        }



        // =========================================================
        // SAYFA AÇILDIĞINDA
        // =========================================================

        cihazDurumunuGetir();



        // =========================================================
        // 10 SANİYEDE BİR CİHAZ DURUMUNU KONTROL ET
        // =========================================================

        setInterval(
            cihazDurumunuGetir,
            10000
        );

    </script>

}