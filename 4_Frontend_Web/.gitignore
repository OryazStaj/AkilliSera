.nuxt/
.svelte-kit/
.vite/
.cache/
coverage/
.env.*
!.env.example
!.env.sample
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.tmp
*.temp
.vscode/
.idea/
.DS_Store
Thumbs.db
