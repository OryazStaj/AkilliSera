# Python .gitignore Kuralları
__pycache__/
*.py[cod]
.venv/
env/

# Büyük / gereksiz model uzantıları
*.weights
*.pth
*.h5
*.keras
*.pb
*.tflite
*.pkl

# Geçici çalışma zamanı çıktıları (her çalıştırmada üzerine yazılanlar)
Goruntu_Isleme/kamera_anlik.jpg
Goruntu_Isleme/sonuc.jpg
Goruntu_Isleme/yeni_test_sonucu.jpg
Goruntu_Isleme/analiz-sonucu.json

# Temel Python/IDE dosyaları
*.log
*.tmp
*.temp
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Zorunlu model dosyaları (Projeyle birlikte versiyonlanır)
!Goruntu_Isleme/model.onnx
!Goruntu_Isleme/model_domates.onnx
